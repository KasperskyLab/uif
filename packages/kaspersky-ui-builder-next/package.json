{
  "name": "@kaspersky/ui-builder-next",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:registry": "node scripts/generate-component-registry.mjs",
    "check:palette": "node scripts/generate-component-registry.mjs",
    "check:domain": "node --experimental-strip-types scripts/check-domain.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@kaspersky/hexa-ui": "^6.387.4",
    "@kaspersky/hexa-ui-icons": "^2.19.0",
    "@types/node": "^24",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^7.3.1"
  },
  "overrides": {
    "open": "10.1.2"
  }
}
