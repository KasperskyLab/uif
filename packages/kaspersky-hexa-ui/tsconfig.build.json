{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true
  },
  "exclude": [
    "**/stories",
    "**/*.stories.tsx",
    "**/__tests__",
    "**/*.test.ts*",
    ".changelog",
    ".storybook",
    "docs",
    "screenshots",
    "setupTests.ts",
    "tests",
    "**/__mocks__",
    "**/test-utils"
  ]
}
